{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and preferences",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "likedSongs": { "type": "array", "description": "List of track file names or hashes that are liked" }
      },
      "required": ["email"]
    },
    "Playlist": {
      "title": "User Playlist",
      "description": "Custom playlists created by the user",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "tracks": { "type": "array", "description": "List of track identifiers" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId"]
    },
    "Presence": {
      "title": "User Presence",
      "description": "Real-time presence and listening status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "status": { "type": "string", "enum": ["online", "away"] },
        "lastActive": { "type": "string", "format": "date-time" },
        "currentTrack": { "type": "string", "description": "Title of the track currently being played" }
      },
      "required": ["uid", "status", "lastActive"]
    },
    "GlobalMessage": {
      "title": "Global Chat Message",
      "description": "Messages sent to the global community chat",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "text", "createdAt"]
    },
    "Song": {
      "title": "Uploaded Song",
      "description": "Songs uploaded by the user to the cloud",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "album": { "type": "string" },
        "duration": { "type": "number" },
        "ownerId": { "type": "string" },
        "storagePath": { "type": "string", "description": "The path in Firebase Storage" },
        "downloadUrl": { "type": "string" },
        "coverUrl": { "type": "string" },
        "isPublic": { "type": "boolean", "description": "Whether the song is shared with the community" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "ownerId", "storagePath", "downloadUrl", "createdAt"]
    },
    "ListenHistory": {
      "title": "Listening History",
      "description": "Records of tracks played by users",
      "type": "object",
      "properties": {
        "trackId": { "type": "string" },
        "artist": { "type": "string" },
        "title": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["trackId", "userId", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Main user documents"
    },
    "/playlists/{playlistId}": {
      "schema": "Playlist",
      "description": "User playlists stored centrally"
    },
    "/presence/{userId}": {
      "schema": "Presence",
      "description": "Real-time user presence tracking"
    },
    "/messages/{messageId}": {
      "schema": "GlobalMessage",
      "description": "Global chat messages"
    },
    "/songs/{songId}": {
      "schema": "Song",
      "description": "Metadata for tracks saved in the cloud"
    },
    "/listening_history/{id}": {
      "schema": "ListenHistory",
      "description": "User listening events for reports"
    }
  }
}
