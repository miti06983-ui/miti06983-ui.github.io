rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email']) && 
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('likedSongs' in data) || (data.likedSongs is list && data.likedSongs.size() <= 1000));
    }

    function isValidPresence(data) {
      return data.keys().hasAll(['uid', 'status', 'lastActive']) &&
             data.uid == request.auth.uid &&
             data.status in ['online', 'away'] &&
             data.lastActive is timestamp &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('currentTrack' in data) || data.currentTrack == null || (data.currentTrack is string && data.currentTrack.size() <= 256));
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['uid', 'text', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
             data.createdAt is timestamp &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    function isValidSong(data) {
      return data.keys().hasAll(['title', 'ownerId', 'storagePath', 'downloadUrl', 'createdAt']) &&
             data.ownerId == request.auth.uid &&
             data.title is string && data.title.size() <= 256 &&
             data.storagePath is string && data.storagePath.size() <= 1024 &&
             data.downloadUrl is string && data.downloadUrl.size() <= 2048 &&
             data.createdAt is timestamp &&
             (!('isPublic' in data) || (data.isPublic is bool)) &&
             (!('artist' in data) || (data.artist is string && data.artist.size() <= 256)) &&
             (!('album' in data) || (data.album is string && data.album.size() <= 256)) &&
             (!('duration' in data) || (data.duration is number)) &&
             (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 2048));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'likedSongs']);
    }

    match /songs/{songId} {
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true);
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isSignedIn() && isValidSong(request.resource.data);
      allow update: if isOwner(resource.data.ownerId) && isValidSong(request.resource.data);
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /playlists/{playlistId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid && 
                      request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /presence/{userId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isOwner(userId) && isValidPresence(request.resource.data);
      allow update: if isOwner(userId) && isValidPresence(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /messages/{messageId} {
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidMessage(request.resource.data);
    }

    function isValidHistory(data) {
      return data.keys().hasAll(['trackId', 'artist', 'title', 'timestamp', 'userId']) &&
             data.userId == request.auth.uid &&
             data.trackId is string && data.trackId.size() <= 256 &&
             data.artist is string && data.artist.size() <= 256 &&
             data.title is string && data.title.size() <= 256 &&
             data.timestamp is timestamp;
    }

    match /listening_history/{historyId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidHistory(request.resource.data);
    }
  }
}
